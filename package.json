{
  "name": "bookeeper",
  "version": "2.0.0",
  "private": true,
  "description": "车辆记账与看板（泵车 / 搅拌车），Node.js + MySQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "node -e \"const {cpSync}=require('node:fs'); cpSync('src/public','dist/src/public',{recursive:true,filter:file=>!file.endsWith('.ts')}); cpSync('db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/src/server/index.js",
    "dev": "npm run copy:assets && tsc-watch --project tsconfig.build.json --onSuccess \"npm start\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc && npm run copy:assets && cd dist/tests && node --test"
  },
  "dependencies": {
    "mysql2": "3.11.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3"
  }
}
