# 应用端口（容器内）
PORT=3000
TIME_ZONE=Asia/Shanghai

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=bookeeper
MYSQL_USER=bookeeper
MYSQL_PASSWORD=change-me-app

# 访问密码：留空则不校验（仅建议在内网使用）
APP_PASSWORD=
# 会话签名密钥，随便一串长随机字符
SESSION_SECRET=change-me-session-secret

# 拍照识别：阿里云百炼（DashScope）API Key，留空则「拍照」页不可用
DASHSCOPE_API_KEY=
DASHSCOPE_VL_MODEL=qwen3-vl-plus
