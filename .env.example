# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=bookeeper
MYSQL_USER=bookeeper
MYSQL_PASSWORD=change-me-app

# 访问密码：留空则不校验（仅建议在内网使用）
